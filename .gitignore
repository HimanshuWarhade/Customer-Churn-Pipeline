# # Python
# __pycache__/
# *.py[cod]
# *.egg-info/
# build/
# dist/

# # Virtual environment
# venv/
# .venv/
# env/

# # Jupyter
# .ipynb_checkpoints/

# # Data (never commit raw/processed data files themselves)
# data/raw/*
# !data/raw/.gitkeep
# data/processed/*
# !data/processed/.gitkeep

# # Trained models
# models/*
# !models/.gitkeep

# # Generated reports -- these ARE committed (charts, data dictionary,
# # model report are real deliverables the README links to). Nothing to
# # ignore here on purpose.

# # Secrets
# .env

# # OS / editor
# .DS_Store
# .vscode/
# .idea/
